# TweetSense Environment Configuration Example
# Copy this file to .env and configure your local or deployment secrets.

# 1. Database URL: PostgreSQL (Supabase pooler) or local SQLite
# Production: postgresql://postgres.xxxx:your_password@aws-0-xx.pooler.supabase.com:6543/postgres
# Local SQLite fallback: sqlite:///./tweetsense.db
DATABASE_URL=sqlite:///./tweetsense.db

# 2. JWT Authentication Secret (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# 3. LLM API Key (Optional — priority triage falls back to deterministic rules if empty)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# 4. CORS Allowed Origins (comma-separated list of frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sentiment-analysis-nine-zeta.vercel.app

# 5. Server Options
PORT=5000
DEBUG=false
