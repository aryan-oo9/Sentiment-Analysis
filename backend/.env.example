# Backend Configuration & Environment Variables

# Server & Runtime
FLASK_DEBUG=false
FLASK_ENV=production
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Local SQLite fallback for dev/testing:
DATABASE_URL=sqlite:///tweetsense.db
# Production Supabase PostgreSQL (Use Transaction Pooler URL on port 6543):
# DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRATION_HOURS=24

# External LLM API (for zero-shot priority, briefings, reply drafts)
# Free tier key: Google Gemini API key or OpenAI/Groq key
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
